{
  "manifest_version": 3,
  "name": "BaoVang - Auto Zalo Web",
  "version": "1.2.3",
  "description": "Gửi tuần tự thông báo báo vắng từ BaoVang qua Zalo Web.",
  "permissions": ["tabs", "storage", "scripting", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["https://baovang.vercel.app/*", "https://chat.zalo.me/*", "https://zalo.me/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://baovang.vercel.app/*", "https://chat.zalo.me/*", "https://zalo.me/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BaoVang Auto Zalo"
  }
}
